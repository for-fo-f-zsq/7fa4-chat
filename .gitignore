/build/
/clean/
/out/
/out-tmp/
/node_modules/
/src/renderer/public/users.json
/del_out.json
/patch_out.json
/rel_body.json
/up_out.json
/tmp/
/.*/
!/.github/

# 本地开发模拟文件（含敏感凭据，不入库）
website-dev/

# 本地测试残留（如 dev/null 等），不入库
/dev/

# Android（Capacitor）构建与生成产物：均由 build-web.mjs + cap sync 重新生成
/android/local.properties
/android/.gradle/
/android/build/
/android/app/build/
/android/capacitor-cordova-android-plugins/build/
/android/app/src/main/assets/public/
/android/.idea/
/android/app/release.keystore
/android/.keystore-pass

# Linux AppImage 本地打包产物（Docker 构建输出，体积大）
/artifacts/

# 工具包构建产物（由 scripts/build-tools.mjs 生成，发布到 GitLab 包仓库，不入库）
/dist-tools/

# 本地环境变量（含 GITLAB_TOKEN 等发布凭据，严禁入库）
.env
.env.local

# 临时运行与日志文件
tmp-*
*.log
*.err

# 官网与反馈服务运行时产生的数据（含用户反馈、会话密钥，不入库）
/site/data/feedback/.secret
/site/data/feedback/items.json
/site/data/feedback/attachments/*
!/site/data/feedback/attachments/.gitkeep

# 站点本地静态托管的网页端同步产物（由 build:web --copy-to-site 生成，避免重复大文件入库）
/site/public/web/


